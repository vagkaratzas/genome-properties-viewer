{
  "name": "genome-properties-viewer",
  "version": "1.0.0-beta.1",
  "description": "A heatmap styled viewer for the genome properties",
  "main": "index.js",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -cw",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:lint": "eslint --color \"./**/*.js\"",
    "browser-sync": "browser-sync start --server -f bin/*.*",
    "serve": "npm run watch & npm run browser-sync",
    "create-taxonomy-file": "node scripts/retrieve_taxonomy.js > taxonomy.json",
    "prettier": "prettier --write src/*",
    "prepare": "husky",
    "jsdoc": "jsdoc2md src/*.js > reference.md",
    "create-erz-steps": "python3 scripts/create-erz-steps.py",
    "create-erz-merged": "node scripts/create-erz-merged.js",
    "create-opu-steps": "python3 scripts/create-opu-steps.py",
    "create-opu-merged": "node scripts/create-opu-merged.js",
    "resolve-opu-taxa": "python3 scripts/resolve-opu-taxa.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProteinsWebTeam/genome-properties-viewer.git"
  },
  "keywords": [
    "genome",
    "properties",
    "heatmap"
  ],
  "author": "Gustavo A. Salazar",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/ProteinsWebTeam/genome-properties-viewer/issues"
  },
  "homepage": "https://github.com/ProteinsWebTeam/genome-properties-viewer#readme",
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-dispatch": "^3.0.1",
    "d3-drag": "^3.0.0",
    "d3-dsv": "^3.0.1",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-timer": "^3.0.1",
    "d3-transition": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.4",
    "@playwright/test": "^1.58.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "browser-sync": "^3.0.4",
    "eslint": "^10.0.2",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdoc-to-markdown": "^9.1.3",
    "jsdom": "^28.1.0",
    "mysql": "2.18.1",
    "prettier": "^3.8.1",
    "rollup": "^4.59.0",
    "vitest": "^4.0.18"
  }
}
